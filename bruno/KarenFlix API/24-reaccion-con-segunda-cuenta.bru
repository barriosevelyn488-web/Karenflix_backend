  token: {{otherToken}}
}

headers {
  Content-Type: application/json
}

body:json {
{
  "tipo": "like"
}
}

tests {
  test("Reacción a reseña ajena devuelve un estado esperado", function () {
    expect([200, 401, 403, 404]).to.include(res.getStatus());
  });
}
