meta {
  name: "Crear categoría admin"
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/categorias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
{
  "nombre": "Demo Bruno",
  "descripcion": "Categoría temporal para pruebas"
}
 }

tests {
  test("Crear categoría admin devuelve un estado permitido", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

script:post-response {
  if (res.getStatus() === 201) bru.setEnvVar('categoryId', String(res.getBody().data.id));
}
