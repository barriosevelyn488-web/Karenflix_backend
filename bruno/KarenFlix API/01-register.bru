meta {
  name: "Registrar usuario"
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
{
  "nombre": "Usuario Bruno",
  "email": "bruno.demo@example.com",
  "password": "BrunoDemo2026!"
}
 }

tests {
  test("Registrar usuario devuelve un estado permitido", function () {
    expect([201, 409]).to.include(res.getStatus());
  });
}

script:post-response {
  if (res.getStatus() === 201) bru.setEnvVar('token', res.getBody().data.token);
}
