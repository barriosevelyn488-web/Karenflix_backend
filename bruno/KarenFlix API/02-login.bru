 }

tests {
  test("Iniciar sesión devuelve un estado permitido", function () {
    expect([200]).to.include(res.getStatus());
  });
}

script:post-response {
  bru.setEnvVar('token', res.getBody().data.token); bru.setEnvVar('userId', String(res.getBody().data.usuario.id));
}
